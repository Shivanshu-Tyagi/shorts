# ======================= REQUIRED (unchanged) =======================
PORT=5000
BASE_URL=
MONGO_URL=mongodb://localhost:27017/shorts
REDIS_URL=redis://localhost:6379        # needed by BullMQ (API + worker). NOTE: was missing from the old .env
AWS_KEY=
AWS_SECRET=
AWS_REGION=
BUCKET=
CDN_DOMAIN=
# External downloader provider (RapidAPI). RAPID_API_HOST holds the FULL endpoint URL (legacy naming kept).
RAPID_API_KEY=
RAPID_API_HOST=
# APIFY_TOKEN= (present in the old .env but not used by any code in this project)

# ======================= NEW: provider billing protection =======================
PROVIDER_TIMEOUT_MS=15000            # per HTTP attempt
PROVIDER_MAX_ATTEMPTS=2              # TOTAL attempts per operation (old code: 3 here + the worker repeated it). 1 = never retry
PROVIDER_RETRY_BASE_MS=500           # exponential backoff base (jittered); retries only on network/timeout/5xx, never 4xx/429
PROVIDER_BREAKER_THRESHOLD=5         # consecutive provider failures before the circuit opens
PROVIDER_BREAKER_COOLDOWN_MS=30000
PROVIDER_COST_PER_CALL_USD=          # optional: enables estimatedProviderCostUsd in metrics (e.g. 0.002)
RAPID_API_HOST_HEADER=social-download-all-in-one.p.rapidapi.com

# ======================= NEW: reuse / cache policy =======================
MEDIA_URL_TTL_SECONDS=600            # how long a provider media URL is trusted (shorter wins if the URL carries its own expiry)
NEGATIVE_CACHE_TTL_SECONDS=300       # permanent failures (private/deleted/no media) are remembered this long
TRANSIENT_COOLDOWN_MS=5000           # transient failures (timeout/5xx/429) are shared with concurrent callers this long
ASSET_CACHE_TTL_MS=300000            # in-process cache of already-stored videos
PROCESSING_STALE_MS=900000           # a queued/processing job older than this is considered lost and re-queued
LOCK_POLL_MS=150

# ======================= NEW: queue / worker =======================
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000
WORKER_CONCURRENCY=1
MAX_MEDIA_BYTES=209715200            # 200 MB hard cap per downloaded file
MEDIA_DOWNLOAD_TIMEOUT_MS=30000
MEDIA_MAX_REDIRECTS=3
MEDIA_REFRESH_MAX=1                  # max provider refreshes per job run when the media URL is dead

# ======================= NEW: feature flags / security =======================
DOWNLOADER_ENABLED=true              # global kill switch -> 503 DOWNLOADS_DISABLED
DISABLED_PLATFORMS=                  # e.g. youtube,reddit
EXTRA_ALLOWED_HOSTS=                 # opt-in extra provider-supported domains, e.g. vimeo.com,dailymotion.com
MAX_URL_LENGTH=2048
REQUEST_DEADLINE_MS=                 # default = provider budget + 10s
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PER_DEVICE=20
RATE_LIMIT_PER_IP=120
TRUST_PROXY=                         # set (e.g. 1) when behind nginx/ALB, otherwise per-IP limits see the proxy's IP
METRICS_TOKEN=                       # enables GET /api/internal/download-metrics (header x-metrics-token). Unset => 404
MONGO_AUTO_INDEX=true                # set false in prod after running `npm run db:ensure-indexes`
LOG_LEVEL=info

# ======================= NEW: download limits + rewarded ads =======================
# Limits are DYNAMIC. Resolution order: DB override (PUT /api/internal/settings/:appId) > these env vars > built-in defaults.
DL_QUOTA_ENABLED=true                # master switch
DL_FREE_DOWNLOADS=3                  # initial free downloads per device per app
DL_REWARDED_DOWNLOADS=3              # downloads unlocked by ONE verified rewarded ad (0 = rewards off)
DL_REWARDED_ADS_ENABLED=true
DL_MAX_REWARDED_ADS_PER_DAY=10       # rolling 24h per device, 0 = unlimited
DL_MAX_REWARDED_ADS_TOTAL=0          # lifetime per device, 0 = unlimited
DL_REWARD_COOLDOWN_SECONDS=0
DL_REWARD_SHOW_WHEN_REMAINING_AT_MOST=0
DL_REWARD_SESSION_TTL_SECONDS=600
DL_RESERVATION_TTL_SECONDS=1800      # must exceed the longest worker job
DL_ENFORCE_WITHOUT_REWARDED_AD=false # keep false: quota stays inert until a rewarded ad unit is configured (no lock-out)
DL_STATUS_POLL_INTERVAL_MS=2000
DL_STATUS_POLL_TIMEOUT_MS=30000
SETTINGS_CACHE_TTL_MS=30000
REQUIRE_APP_ID=false                 # true = reject downloads from old app builds that do not send appId (use after forcing an update)
ADMIN_TOKEN=                         # enables GET/PUT /api/internal/settings/:appId (header x-admin-token). Unset => endpoint returns 404
ALLOW_CLIENT_REWARD_VERIFICATION=false  # INSECURE client-confirmed rewards. Leave false in production.
ADMOB_SSV_MAX_AGE_SECONDS=3600
